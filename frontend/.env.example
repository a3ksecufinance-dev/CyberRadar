# ============================================================
# CyberRadar Frontend — Environment Variables Example
# Copy to .env.local and fill in your values
# ============================================================

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=CyberRadar

# ─── NextAuth ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Auth.js refuses to trust the Host header unless told to, and signing in fails
# with UntrustedHost without it — anywhere that is not Vercel. It is an opt-in
# rather than a default because a proxy forwarding an attacker-controlled Host
# could otherwise redirect the OIDC callback somewhere else. Set it where the
# host reaching the app is yours; behind a load balancer, make sure it rewrites
# Host rather than passing the client's through.
#
# It has to be in the PROCESS environment, not only in this file: the check
# runs inside the Next middleware, and a value that lives only in .env.local
# does not reach the edge runtime. The symptom is a 500 on
# /api/auth/signin/keycloak saying "a problem with the server configuration".
AUTH_TRUST_HOST=true

# ─── Keycloak OIDC ───────────────────────────────────────────
# Keycloak realm: http://localhost:8080/realms/cyberradar
KEYCLOAK_CLIENT_ID=cyberradar-frontend
KEYCLOAK_CLIENT_SECRET=<from-keycloak-admin-console>
KEYCLOAK_ISSUER=http://localhost:8080/realms/cyberradar

# ─── Backend API ─────────────────────────────────────────────
# Points to the foundation / gateway service
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── Feature Flags ───────────────────────────────────────────
NEXT_PUBLIC_ENABLE_COPILOT=true
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
